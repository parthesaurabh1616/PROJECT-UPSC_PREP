generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ══════════════════════════════════════════════════════════════
//  CIVIL SERVICES CORE ENGINE — multi-exam configuration layer
//  Exam (UPSC | MPSC | future PCS) is data, not code. Every exam
//  runs on the same engine; differences live in config + content.
// ══════════════════════════════════════════════════════════════

// ── Exam: the configurable exam definition ────────────────────
model Exam {
  id          String   @id @default(cuid())
  code        String   @unique          // "UPSC" | "MPSC" | future "MPSC-CDPO" etc.
  name        String                     // "UPSC Civil Services Examination"
  shortName   String                     // "UPSC CSE"
  authority   String                     // "Union Public Service Commission"
  languages   String[] @default(["en"]) // ["en"] | ["en","mr"]
  accentColor String   @default("accent")// theme hook
  config      Json     @default("{}")    // freeform: cutoffs, negative marking, etc.
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stages        ExamStage[]
  syllabusNodes SyllabusNode[]
  profiles      UserExamProfile[]

  @@map("exams")
}

// ── ExamStage: Prelims / Mains / Interview — JSON paper structure
model ExamStage {
  id        String   @id @default(cuid())
  examId    String
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  type      String                       // "prelims" | "mains" | "interview"
  name      String                       // "Preliminary Examination"
  totalMarks Int     @default(0)
  // papers: [{ code, name, marks, durationMin, qualifying, type:"objective|descriptive" }]
  papers    Json     @default("[]")
  sortOrder Int      @default(0)

  @@unique([examId, type])
  @@map("exam_stages")
}

// ── SyllabusNode: the SPINE. Everything links here. ───────────
model SyllabusNode {
  id         String   @id @default(cuid())
  examId     String
  exam       Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  parentId   String?
  parent     SyllabusNode?  @relation("NodeChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children   SyllabusNode[] @relation("NodeChildren")
  code       String                       // "GS2.POLITY.BASIC_STRUCTURE"
  title      String
  titleMr    String?                      // Marathi variant (MPSC)
  stage      String?                      // "prelims" | "mains" — which stage it belongs to
  paperCode  String?                      // "GS-II", "ESSAY", "OPTIONAL"
  weight     Int      @default(0)         // historical exam weight 0-100
  depth      Int      @default(0)         // tree depth for fast rendering
  path       String   @default("")        // materialized path "root/polity/basic-structure"
  sortOrder  Int      @default(0)

  @@unique([examId, code])
  @@index([examId, parentId])
  @@index([examId, paperCode])
  @@map("syllabus_nodes")
}

// ── UserExamProfile: a user's prep against a specific exam ─────
model UserExamProfile {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  examId          String
  exam            Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  isPrimary       Boolean  @default(false)
  optionalSubject String?
  targetYear      Int?
  prelimsDate     DateTime?                  // exact dates (user-set) → precise countdown
  mainsDate       DateTime?
  interviewDate   DateTime?
  targetMarks     Int?                        // final-total goal (e.g. 1100) for benchmarking
  language        String   @default("en") // preferred UI/AI language for this exam
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, examId])
  @@index([userId, isPrimary])
  @@map("user_exam_profiles")
}

// ── User ──────────────────────────────────────────────────────
model User {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  conversations Conversation[]
  notes         Note[]
  revisions     Revision[]
  studySessions StudySession[]
  tasks         Task[]
  files         LibraryFile[]
  examProfiles  UserExamProfile[]
  activity      ActivityEvent[]
  chapterProgress ChapterProgress[]
  pyqAttempts   PyqAttempt[]
  caReads       CaRead[]
  mainsAnswers  MainsAnswer[]
  testAttempts  TestAttempt[]
  sprints       Sprint[]

  @@map("users")
}

// ══════════════════════════════════════════════════════════════
//  PRELIMS TEST ENGINE — an MCQ bank + auto-graded attempts.
//  The ONLY source of real objective-test performance, so the
//  Command Center can show measured Prelims readiness.
// ══════════════════════════════════════════════════════════════
model Mcq {
  id          String   @id @default(cuid())
  examCode    String   @default("UPSC")
  subject     String                          // History | Geography | Polity | Economy | Environment | Science & Tech | Current Affairs
  topic       String?
  question    String
  options     String[]                        // exactly 4
  answerIndex Int                             // 0..3
  explanation String   @default("")
  source      String   @default("ai")         // ai | ncert | pyq
  difficulty  String   @default("medium")
  createdAt   DateTime @default(now())

  @@index([examCode, subject])
  @@map("mcqs")
}

model TestAttempt {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  examCode    String   @default("UPSC")
  mode        String   @default("subject")    // subject | mixed
  subject     String?
  totalQ      Int
  correct     Int
  wrong       Int
  skipped     Int
  score       Float                            // UPSC marking: +2 correct, −0.66 wrong
  maxScore    Float
  percent     Int
  durationSec Int      @default(0)
  answers     Json                             // [{ mcqId, chosen, correctIndex }]
  bySubject   Json?                            // [{ subject, correct, total }]
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@map("test_attempts")
}

// ══════════════════════════════════════════════════════════════
//  MAINS ANSWER LAB — AI-evaluated descriptive answers. This is
//  the ONLY source of real written-paper scores, so the Command
//  Center can compute a genuine (not benchmark-only) gap to target.
// ══════════════════════════════════════════════════════════════
model MainsAnswer {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  examCode     String   @default("UPSC")
  questionId   String?                         // optional link to a real PyqQuestion
  paperCode    String                          // GS-I | GS-II | GS-III | GS-IV | ESSAY | OPTIONAL
  questionText String
  maxMarks     Int                             // 10 | 15 | 125 | 250
  answerText   String
  wordCount    Int      @default(0)
  score        Float?                          // AI-assigned, realistic UPSC marking
  breakdown    Json?                           // [{ dimension, score, max, comment }]
  strengths    String[]
  improvements String[]
  verdict      String?                         // one-line examiner verdict
  evaluatedAt  DateTime?
  createdAt    DateTime @default(now())

  @@index([userId, paperCode])
  @@index([userId, evaluatedAt])
  @@map("mains_answers")
}

// ══════════════════════════════════════════════════════════════
//  ACTIVITY LEDGER — the single source of truth for every metric.
//  Append-only. Every honest dashboard number is a GROUP BY over
//  this table. If there is no event, the metric shows "no data".
// ══════════════════════════════════════════════════════════════
model ActivityEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  examCode  String   @default("UPSC")
  // CHAPTER_READ | PYQ_ATTEMPTED | CA_READ | NOTE_CREATED |
  // REVISION_REVIEWED | STUDY_SESSION | TEST_ATTEMPTED | ANSWER_WRITTEN
  type      String
  refId     String?                   // chapterId / questionId / affairId / noteId / cardId
  subject   String?                   // for per-subject rollups
  value     Int      @default(0)      // minutes (study), correct=1/partial/0 (pyq), SM-2 grade (review)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, type])
  @@index([userId, subject])
  @@map("activity_events")
}

// ── Per-user NCERT chapter completion ─────────────────────────
model ChapterProgress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapterId   String
  status      String   @default("completed") // reading | completed
  completedAt DateTime @default(now())

  @@unique([userId, chapterId])
  @@index([userId])
  @@map("chapter_progress")
}

// ── Per-user PYQ attempt (self-rated) ─────────────────────────
model PyqAttempt {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId  String
  paperId     String?
  subject     String?
  selfRating  String   @default("attempted") // correct | partial | wrong | attempted
  attemptedAt DateTime @default(now())

  @@unique([userId, questionId])
  @@index([userId])
  @@map("pyq_attempts")
}

// ── Per-user current-affairs read receipt ─────────────────────
model CaRead {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  affairId  String
  readAt    DateTime @default(now())

  @@unique([userId, affairId])
  @@index([userId])
  @@map("ca_reads")
}

// ── AI Mentor: conversations + messages ───────────────────────
model Conversation {
  id        String    @id @default(cuid())
  title     String    @default("New conversation")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  role           String       // "user" | "assistant"
  content        String
  createdAt      DateTime     @default(now())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("messages")
}

// ══════════════════════════════════════════════════════════════
//  NCERT Library — normalized from the raw PDF folder by the scan
// ══════════════════════════════════════════════════════════════
model NcertBook {
  id         String   @id @default(cuid())
  klass      Int                          // 6..12
  subject    String                       // History | Geography | Polity | Economics | Science | Social Science
  title      String                       // "Themes in Indian History - I"
  code       String?                      // NCERT book code prefix, e.g. "lehs1"
  coverStyle Int      @default(0)         // deterministic gradient cover index
  chapterCount Int    @default(0)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  chapters   NcertChapter[]

  @@unique([klass, subject, title])
  @@index([klass, subject])
  @@map("ncert_books")
}

model NcertChapter {
  id        String   @id @default(cuid())
  bookId    String
  book      NcertBook @relation(fields: [bookId], references: [id], onDelete: Cascade)
  order     Int                           // sequence within the book
  code      String?                       // file code e.g. "lehs101"
  title     String                        // human chapter title (extracted) or "Chapter N"
  kind      String   @default("chapter")  // chapter | frontmatter | glossary | answers | other
  chapterNo Int?                          // numeric chapter number when applicable
  pdfPath   String                        // absolute path on disk (streamed, not copied)
  sizeBytes Int      @default(0)

  // ── AI study tools (Gemini reads the PDF directly; cached) ──
  aiSummary    String?
  aiConcepts   String[]                    // key concepts
  aiFacts      String[]                    // high-yield facts
  aiMcqs       Json?                       // [{ q, options[], answer, explanation }]
  aiProcessedAt DateTime?

  @@index([bookId, order])
  @@map("ncert_chapters")
}

// ══════════════════════════════════════════════════════════════
//  PYQ Intelligence — past papers normalized + AI-extracted Qs
// ══════════════════════════════════════════════════════════════
model PyqPaper {
  id        String   @id @default(cuid())
  examCode  String   @default("UPSC")     // UPSC | MPSC
  stage     String                         // prelims | mains
  year      Int
  paperCode String                         // GS-I | GS-II | GS-III | GS-IV | ESSAY | CSAT | ENGLISH | OPTIONAL | LITERATURE
  paperName String                         // human label
  pdfPath   String                         // streamed from disk
  sizeBytes Int      @default(0)
  questionCount Int  @default(0)
  extractedAt DateTime?                     // when AI extracted questions
  createdAt DateTime @default(now())

  questions PyqQuestion[]

  @@unique([examCode, stage, year, paperCode])
  @@index([examCode, stage, year])
  @@index([paperCode])
  @@map("pyq_papers")
}

model PyqQuestion {
  id        String   @id @default(cuid())
  paperId   String
  paper     PyqPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  number    String                         // "1(a)", "Q12", etc.
  text      String
  marks     Int?
  topic     String?                        // AI topic label
  subtopic  String?
  gsMapping String[]                        // ["GS-II"] paper areas
  keywords  String[]
  createdAt DateTime @default(now())

  @@index([paperId])
  @@index([topic])
  @@map("pyq_questions")
}

// ══════════════════════════════════════════════════════════════
//  SEMANTIC INDEX — pgvector embeddings of all platform content.
//  Powers the AI Mentor's meaning-based retrieval (not keywords).
//  The `embedding` column is written/queried via raw SQL because
//  Prisma Client cannot operate on the native `vector` type.
// ══════════════════════════════════════════════════════════════
model Embedding {
  id        String   @id @default(cuid())
  kind      String                          // CA | PYQ | NCERT | NOTE
  refId     String                          // id of the source row
  examCode  String   @default("UPSC")
  content   String                          // the text that was embedded (for display/debug)
  embedding Unsupported("vector(768)")?     // text-embedding-004 → 768 dims
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([kind, refId])
  @@index([kind])
  @@map("embeddings")
}

// ── Notes (second brain) ──────────────────────────────────────
model Note {
  id        String   @id @default(cuid())
  title     String
  content   String   @default("")
  subject   String?
  tags      String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  revisions Revision[]

  @@map("notes")
}

// ── Revision cards (SM-2 spaced repetition) ───────────────────
model Revision {
  id          String   @id @default(cuid())
  front       String
  back        String
  subject     String?
  easeFactor  Float    @default(2.5)
  interval    Int      @default(1)      // days until next review
  repetitions Int      @default(0)
  dueAt       DateTime @default(now())
  reviewCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  noteId      String?
  note        Note?    @relation(fields: [noteId], references: [id], onDelete: SetNull)

  @@map("revisions")
}

// ── Study Sessions ────────────────────────────────────────────
model StudySession {
  id        String   @id @default(cuid())
  date      DateTime @default(now())
  duration  Int      // minutes
  subject   String?
  notes     String?
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("study_sessions")
}

// ── Tasks ─────────────────────────────────────────────────────
model Task {
  id        String   @id @default(cuid())
  title     String
  subject   String?
  done      Boolean  @default(false)
  dueAt     DateTime?
  priority  Int      @default(2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tasks")
}

// ── Sprint Board (Agile program OS) ───────────────────────────
model Sprint {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal      String
  startsAt  DateTime
  endsAt    DateTime
  retro     String?              // sprint retrospective, written at review
  createdAt DateTime @default(now())
  tasks     SprintTask[]

  @@index([userId, startsAt])
  @@map("sprints")
}

model SprintTask {
  id        String   @id @default(cuid())
  sprintId  String
  sprint    Sprint   @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  title     String
  // Ticket type (IAS OS FR-3): CLASS | LEARN | REVISE | PRACTICE | WRITE | ADMIN
  type      String   @default("LEARN")
  // COS link: syllabus node this ticket studies/revises (Phase 3)
  nodeId    String?
  // metric-bound tickets auto-track progress from the activity ledger on read
  // (never stored): answers | pyq | ncert | ca | revision | focus | tests | notes.
  // "manual" = plain checkbox.
  metric    String   @default("manual")
  target    Int      @default(1)
  done      Boolean  @default(false) // explicit completion override
  createdAt DateTime @default(now())

  @@index([sprintId])
  @@map("sprint_tasks")
}

// ── Cognitive Operating System (Phase 3) ─────────────────────
// The twin's memory of a syllabus node. Ledger stays the source of
// truth — this row caches derived state (recomputable by replay).
model TopicState {
  id             String    @id @default(cuid())
  userId         String
  nodeId         String    // stable syllabus node id (syllabus-data.ts)
  title          String    // denormalised for display
  status         String    @default("TOUCHED") // TOUCHED|PROCESSED|PRACTICED|REVISING|MASTERED|DECAYED
  ladderStage    Int       @default(0)         // 0..5 (R1..R5)
  lastRevisedAt  DateTime?
  nextRevisionAt DateTime?
  lastGrade      Int?
  lqs            Int       @default(0)
  lqsParts       Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, nodeId])
  @@index([userId, nextRevisionAt])
  @@map("topic_states")
}

model DailyCheckin {
  id          String   @id @default(cuid())
  userId      String
  day         DateTime // 04:00-boundary day (date at midnight UTC of that logical day)
  sleepHrs    Float?
  energy      Int?
  mood        Int?
  stress      Int?
  focus       Int?
  confidence  Int?
  distraction Int?
  note        String?
  createdAt   DateTime @default(now())

  @@unique([userId, day])
  @@map("daily_checkins")
}

model DecisionRecord {
  id              String    @id @default(cuid())
  userId          String
  decidedAt       DateTime
  title           String
  decision        String
  reason          String
  evidence        String?
  alternatives    String?
  expectedOutcome String?
  reviewAt        DateTime?
  status          String    @default("ACTIVE") // ACTIVE|REVIEWED|SUPERSEDED
  reviewNote      String?
  createdAt       DateTime  @default(now())

  @@index([userId, status])
  @@map("decision_records")
}

model TopicArtifact {
  id         String   @id @default(cuid())
  userId     String
  nodeId     String
  kind       String   // COLLECTOR|REVISION_NOTE|ONE_PAGER|MINDMAP|FLASHCARDS|RECALL_30
  content    Json
  sourceHash String
  stale      Boolean  @default(false)
  model      String?
  createdAt  DateTime @default(now())

  @@unique([userId, nodeId, kind])
  @@map("topic_artifacts")
}

model ProfileSnapshot {
  id        String   @id @default(cuid())
  userId    String
  weekStart DateTime
  data      Json
  createdAt DateTime @default(now())

  @@unique([userId, weekStart])
  @@map("profile_snapshots")
}

// ── CA source documents (coaching/newspaper PDFs, auto-scanned) ──
model SourceDoc {
  id        String    @id @default(cuid())
  path      String    @unique          // absolute file path
  folder    String                     // source name = folder name
  filename  String
  day       DateTime?                  // parsed from filename (fallback: file mtime)
  size      Int
  mtimeMs   Float
  status    String    @default("PENDING") // PENDING | DECODED | FAILED
  items     Int       @default(0)      // CurrentAffair rows extracted
  error     String?
  decodedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([status])
  @@map("source_docs")
}

// ── Daily CA revision sheets (compiled from Board verdicts) ───
model CaDailySheet {
  id          String   @id @default(cuid())
  userId      String
  day         DateTime // logical day (04:00 boundary), midnight-normalised
  content     Json     // compiled sheet: items by revisionPriority + skip summary
  itemCount   Int      @default(0) // worthy+marginal items on the sheet
  judgedCount Int      @default(0)
  sourceHash  String   // hash of contributing verdict ids — regenerate on change
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([userId, day])
  @@map("ca_daily_sheets")
}

// ── Current Affairs ───────────────────────────────────────────
model CurrentAffair {
  id          String   @id @default(cuid())
  headline    String
  summary     String
  whyInNews   String?
  background  String?
  keyFacts    String?
  gsMapping   String[]
  prelims     String?
  mains       String?
  interview   String?
  tags        String[]
  source      String?
  sourceUrl   String?
  category    String   @default("news")   // "pib" | "editorial" | "international" | "economy" | "news" | "maharashtra"
  examScope   String[] @default(["UPSC", "MPSC"]) // which exams this item is relevant to
  lang        String   @default("en")      // "en" | "mr"
  priority    String   @default("normal") // "high" | "normal" | "low"
  importanceScore Int  @default(0)         // 0-100 intelligence score (Live Actions ranking)
  layer       String   @default("india")   // "global" | "india" | "maharashtra"
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  // ── UPSC Examination Board verdict (AI judgment, clearly labelled) ──
  worthy          Boolean?                 // WORTHY/MARGINAL → true|false, null = not yet judged
  verdict         String?                  // WORTHY | MARGINAL | REJECT
  prelimsProb     Int?                     // Board estimate 0-100
  mainsProb       Int?                     // Board estimate 0-100
  revisionPriority Int?                    // Board estimate 0-100 (drives revision ordering)
  boardVerdict    Json?                    // full structured verdict (traps, links, compression…)
  boardAt         DateTime?

  @@index([category])
  @@index([examScope])
  @@index([importanceScore])
  @@index([publishedAt])
  @@map("current_affairs")
}

// ── Library files ─────────────────────────────────────────────
model LibraryFile {
  id          String   @id @default(cuid())
  name        String
  originalName String
  size        Int      // bytes
  mimeType    String
  s3Key       String
  kind        String   @default("Standard") // "NCERT" | "Standard" | "Optional" | "Govt Report"
  subject     String?
  description String?
  createdAt   DateTime @default(now())

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("library_files")
}
