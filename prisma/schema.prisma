generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── User ──────────────────────────────────────────────────────
model User {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  conversations Conversation[]
  notes         Note[]
  revisions     Revision[]
  studySessions StudySession[]
  tasks         Task[]
  files         LibraryFile[]

  @@map("users")
}

// ── AI Mentor: conversations + messages ───────────────────────
model Conversation {
  id        String    @id @default(cuid())
  title     String    @default("New conversation")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  role           String       // "user" | "assistant"
  content        String
  createdAt      DateTime     @default(now())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("messages")
}

// ── Notes (second brain) ──────────────────────────────────────
model Note {
  id        String   @id @default(cuid())
  title     String
  content   String   @default("")
  subject   String?
  tags      String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  revisions Revision[]

  @@map("notes")
}

// ── Revision cards (SM-2 spaced repetition) ───────────────────
model Revision {
  id          String   @id @default(cuid())
  front       String
  back        String
  subject     String?
  easeFactor  Float    @default(2.5)
  interval    Int      @default(1)      // days until next review
  repetitions Int      @default(0)
  dueAt       DateTime @default(now())
  reviewCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  noteId      String?
  note        Note?    @relation(fields: [noteId], references: [id], onDelete: SetNull)

  @@map("revisions")
}

// ── Study Sessions ────────────────────────────────────────────
model StudySession {
  id        String   @id @default(cuid())
  date      DateTime @default(now())
  duration  Int      // minutes
  subject   String?
  notes     String?
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("study_sessions")
}

// ── Tasks ─────────────────────────────────────────────────────
model Task {
  id        String   @id @default(cuid())
  title     String
  subject   String?
  done      Boolean  @default(false)
  dueAt     DateTime?
  priority  Int      @default(2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tasks")
}

// ── Current Affairs ───────────────────────────────────────────
model CurrentAffair {
  id          String   @id @default(cuid())
  headline    String
  summary     String
  whyInNews   String?
  background  String?
  keyFacts    String?
  gsMapping   String[]
  prelims     String?
  mains       String?
  interview   String?
  tags        String[]
  source      String?
  sourceUrl   String?
  category    String   @default("news")   // "pib" | "editorial" | "international" | "economy" | "news"
  priority    String   @default("normal") // "high" | "normal" | "low"
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([category])
  @@index([publishedAt])
  @@map("current_affairs")
}

// ── Library files ─────────────────────────────────────────────
model LibraryFile {
  id          String   @id @default(cuid())
  name        String
  originalName String
  size        Int      // bytes
  mimeType    String
  s3Key       String
  kind        String   @default("Standard") // "NCERT" | "Standard" | "Optional" | "Govt Report"
  subject     String?
  description String?
  createdAt   DateTime @default(now())

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("library_files")
}
