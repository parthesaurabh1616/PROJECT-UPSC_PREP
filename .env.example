# ──────────────────────────────────────────────────────────────
# UPSC PREP OS — environment configuration
# Copy this file to `.env.local` and fill in real values.
# ──────────────────────────────────────────────────────────────

# ── PostgreSQL (notes, revisions, tests, progress, vectors) ──
# Matches credentials in docker-compose.yml
DATABASE_URL="postgresql://upsc_os:upsc_os_dev_pw@localhost:5432/upsc_os?schema=public"
DIRECT_URL="postgresql://upsc_os:upsc_os_dev_pw@localhost:5432/upsc_os?schema=public"

# ── Redis (caching, background jobs: PDF parsing, embeddings) ──
REDIS_URL="redis://localhost:6379"

# ── MinIO (object storage: NCERTs, reference books, newspapers) ──
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="upsc_os"
S3_SECRET_KEY="upsc_os_dev_pw"
S3_BUCKET="upsc-os-library"
S3_FORCE_PATH_STYLE="true"

# ── Supabase (optional: use instead of local postgres in prod) ──
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ── AI provider (mentor, summaries, MCQ generation, answer eval) ──
# ── AI Models ────────────────────────────────────────────────
# PRIMARY: Gemini 2.5 Flash — best for NCERTs, books, current affairs (1M token context)
# Get free key (no credit card): https://aistudio.google.com
GOOGLE_API_KEY=""

# SECONDARY: Groq Llama 3.3 70B — ultra-fast streaming chat (500+ tokens/sec)
# Get free key (no credit card): https://console.groq.com
GROQ_API_KEY=""

# ── App ──
NEXT_PUBLIC_APP_NAME="UPSC PREP OS"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -- Study library (NCERTs, PYQs, Current Affairs, Crux, Class Schedules) --
# Moved out of OneDrive (sync dehydrated the files). Override only if it moves again.
UPSC_LIBRARY_ROOT="C:\Users\saura\Desktop\UPSC PREP"
